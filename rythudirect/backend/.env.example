# RythuDirect Backend Environment Variables

PROJECT_NAME="RythuDirect"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# JWT Secret Key (Generate a secure random string in production)
SECRET_KEY="rythudirect_super_secret_jwt_key_2026_farm_fair_pricing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL
# For Neon PostgreSQL: postgresql://<user>:<password>@<ep-pooler-xyz>.neon.tech/rythudirect?sslmode=require
# For Local SQLite: sqlite:///./rythudirect.db
DATABASE_URL="sqlite:///./rythudirect.db"

# Payment Gateway Configuration (Mock in dev, Razorpay/Stripe in prod)
PAYMENT_GATEWAY_PROVIDER="mock"
PAYMENT_KEY_ID="mock_key_id"
PAYMENT_KEY_SECRET="mock_key_secret"

# Cloudinary / Object Storage Configuration
CLOUDINARY_CLOUD_NAME="mock_cloud"
CLOUDINARY_API_KEY="mock_key"
CLOUDINARY_API_SECRET="mock_secret"

# Notifications
NOTIFICATION_PROVIDER="mock_sms_email"
