# RythuDirect Backend Configuration
PROJECT_NAME="RythuDirect"
API_V1_STR="/api/v1"
SECRET_KEY="rythudirect-super-secret-key-change-in-production-agricultural-marketplace"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default to SQLite for zero-setup local dev/tests, or configure Neon PostgreSQL:
# Example Neon PostgreSQL: postgresql+pg8000://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="sqlite:///./rythudirect.db"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Third-Party Integrations (Optional in Dev - Mocked automatically if unset)
# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payment Gateway (Razorpay/Stripe - Mocked with 'DEMO' tag when unset)
PAYMENT_GATEWAY_PROVIDER="mock_demo"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# SMS / Notification Provider (Twilio/Fast2SMS - Mocked when unset)
SMS_PROVIDER="mock_console"
